{
  "name": "CSS",
  "scopeName": "source.css",
  "type": "tree-sitter",
  "parser": "tree-sitter-css",
  // Recognizes editor modelines for extensionless stylesheets.
  "firstLineRegex": [
    "-\\*-[^*]*\\bmode\\s*:\\s*css\\b[^*]*-\\*-",
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=css"
  ],
  "fileTypes": ["css"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-css#v0.25.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "css.wasm",
    "highlightsQuery": "css-highlights.scm",
    "injectionsQuery": "css-injections.scm",
    "foldsQuery": "css-folds.scm",
    "tagsQuery": "css-tags.scm",
    "indentsQuery": "css-indents.scm"
  },
  "injectionNames": ["css"]
}
