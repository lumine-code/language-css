{
  "name": "CSS",
  "scopeName": "source.css",
  "type": "tree-sitter",
  "parser": "tree-sitter-css",
  // Matches the TextMate grammar's modeline rule, which would otherwise win by
  // 0.5 against the 0.1 that prefers Tree-sitter.
  "firstLineRegex": [
    "-\\*-[^*]*\\bmode\\s*:\\s*css\\b[^*]*-\\*-",
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=css"
  ],
  "fileTypes": ["css"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-css#v0.25.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter/tree-sitter-css.wasm",
    "highlightsQuery": "tree-sitter/queries/highlights.scm",
    "foldsQuery": "tree-sitter/queries/folds.scm",
    "tagsQuery": "tree-sitter/queries/tags.scm",
    "indentsQuery": "tree-sitter/queries/indents.scm"
  },
  "injectionRegex": "^(css|CSS)$"
}
